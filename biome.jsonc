{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": [
      "**",
      "!**/*.mdx",
      "!**/*.css",
      "!**/countries.json",
      "!**/subdivisions.json",
      "!**/databuddy.js",
      "!apps/better-admin/**",

      "!apps/docs/components/ui",
      "!apps/dashboard/components/ui",
      "!apps/database/components/ui",

      "!apps/docs/components/lib/utils.ts",
      "!apps/dashboard/components/lib/utils.ts",
      "!apps/database/components/lib/utils.ts",

      "!apps/docs/components/hooks/use-mobile.ts",
      "!apps/dashboard/components/hooks/use-mobile.ts",
      "!apps/database/components/hooks/use-mobile.ts"
    ]
  },
  "javascript": {
    "formatter": {
      "indentStyle": "tab",
      "indentWidth": 2
    },
    "globals": ["chrome"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "off",
        "noEvolvingTypes": "off",
        "noImplicitAnyLet": "off",
        "noEmptyBlockStatements": "off",
        "noArrayIndexKey": "off",
        "noDocumentCookie": "off",
        "noShadowRestrictedNames": "off"
      },
      "style": {
        "noNestedTernary": "off",
        "useFilenamingConvention": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noImgElement": "off",
        "noNamespaceImport": "off"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "off",
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "noUnreachable": "off",
        "useHookAtTopLevel": "off"
      },
      "nursery": {
        "noShadow": "off",
        "noNestedComponentDefinitions": "off",
        "noNoninteractiveElementInteractions": "off",
        "noAwaitInLoop": "off",
        "noBitwiseOperators": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off",
        "useFocusableInteractive": "off",
        "useAriaPropsForRole": "off",
        "useKeyWithClickEvents": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  }
}
