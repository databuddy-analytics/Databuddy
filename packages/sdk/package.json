{
  "name": "@databuddy/sdk",
  "version": "3.2.1",
  "description": "Databuddy SDK: open-source, cookieless product analytics with custom events, feature flags, and error tracking for React, Next.js, Vue, and Node.js.",
  "main": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.ts",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "unbuild",
    "prepack": "bun run build",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:install": "playwright install",
    "serve": "bun test-server.ts",
    "vscode:prepublish": "bun run build",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@databuddy/shared": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/bun": "catalog:",
    "@types/node": "^26.0.0",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "unbuild": "^3.6.1",
    "vue": ">=3"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "analytics",
    "product-analytics",
    "web-analytics",
    "cookieless",
    "feature-flags",
    "error-tracking",
    "tracking",
    "databuddy",
    "sdk",
    "react",
    "nextjs",
    "vue",
    "node",
    "mcp"
  ],
  "homepage": "https://databuddy.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/databuddy-analytics/Databuddy.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/databuddy-analytics/databuddy/issues"
  }
}
