{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true,
    "filterUsingTasks": true
  },
  "ui": "tui",
  "envMode": "strict",
  "globalEnv": [
    "AUTUMN_SECRET_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BULLMQ_REDIS_URL",
    "CLICKHOUSE_DQL_URL",
    "CLICKHOUSE_URL",
    "DATABASE_URL",
    "DATABUDDY_API_KEY",
    "DATABUDDY_ENCRYPTION_KEY",
    "DATABUDDY_WEBSITE_ID",
    "DB_POOL_MAX",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "INSIGHTS_BULLMQ_REDIS_URL",
    "INSIGHTS_WORKER_CONCURRENCY",
    "INSIGHTS_WORKER_ENABLED",
    "MARBLE_API_KEY",
    "MARBLE_API_URL",
    "MARBLE_WORKSPACE_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_BASKET_URL",
    "NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID",
    "NEXT_PUBLIC_STATUS_URL",
    "NODE_ENV",
    "NOTRA_API_KEY",
    "REDIS_URL",
    "REDPANDA_BROKER",
    "REDPANDA_PASSWORD",
    "REDPANDA_SSL",
    "REDPANDA_USER",
    "RESEND_API_KEY",
    "RESEND_AUDIENCE_ID",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SERVICE_NAME",
    "TCC_API_KEY",
    "UPTIME_ROUTER_INTEGRATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["^start"],
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CLICKHOUSE_INTEGRATION_TESTS"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "inputs": ["$TURBO_DEFAULT$", "src/clickhouse/schema/**/*.sql"],
      "outputs": ["src/clickhouse/schema/tables.generated.ts"]
    },
    "clickhouse:init": {
      "cache": false,
      "persistent": false
    },
    "dev": {
      "dependsOn": ["@databuddy/sdk#build"],
      "cache": false,
      "persistent": true
    }
  }
}
