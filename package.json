{
  "name": "databuddy",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@evilmartians/lefthook": "^2.1.6",
    "@types/bun": "1.3.14",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^26.0.0",
    "chalk": "^5.6.2",
    "dockerode": "^4.0.10",
    "dotenv-cli": "^10.0.0",
    "ipaddr.js": "^2.3.0",
    "knip": "^6.22.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "ultracite": "^7.6.1"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "overrides": {
    "protobufjs": ">=7.5.5",
    "@slack/web-api": "7.17.0",
    "autumn-js": "1.2.23"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun run setup.ts",
    "build": "NODE_ENV=production dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev --env-mode=loose",
    "start": "NODE_ENV=production dotenv -- turbo run start --env-mode=loose",
    "test": "dotenv -- turbo run test",
    "test:watch": "dotenv -- bun test --watch ./apps",
    "test:coverage": "dotenv -- bun test --coverage ./apps",
    "lint": "bunx ultracite check && bun run lint:policies",
    "knip": "knip",
    "lint:policies": "bunx tsc --project scripts/tsconfig.json && bun test scripts/lint-policy.test.ts && bun scripts/lint-policy.ts",
    "format": "bunx ultracite fix",
    "check-types": "dotenv -- turbo run check-types",
    "generate-db": "turbo run generate --filter=@databuddy/db",
    "db:studio": "dotenv -- turbo run db:studio",
    "clickhouse:init": "dotenv -- turbo run clickhouse:init",
    "clickhouse:dql:init": "dotenv -- bun packages/db/src/clickhouse/dql.ts",
    "db:push": "dotenv -- turbo run db:push",
    "db:migrate": "dotenv -- turbo run db:migrate",
    "db:deploy": "dotenv -- turbo run db:deploy",
    "db:seed": "dotenv -- sh -c 'cd packages/db && bun run db:seed \"$@\"' --",
    "email:dev": "dotenv -- sh -c 'cd packages/email && bun run dev'",
    "email:segments": "dotenv -- sh -c 'cd packages/db && bun run email:segments \"$@\"' --",
    "sdk:build": "turbo run build --filter @databuddy/sdk --filter @databuddy/cache",
    "dev:dashboard": "dotenv -- turbo run dev --env-mode=loose --filter @databuddy/dashboard --filter @databuddy/api --filter @databuddy/insights",
    "dev:insights": "dotenv -- turbo run dev --env-mode=loose --filter @databuddy/insights",
    "dev:slack": "dotenv -- turbo dev --env-mode=loose --filter @databuddy/slack",
    "dev:status": "dotenv -- turbo dev --env-mode=loose --filter @databuddy/status --filter @databuddy/api",
    "git:setup-aliases": "git config --local include.path ../gitconfig",
    "insights:production-shadow": "dotenv -- bun run --cwd apps/insights src/production-shadow.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@databuddy/devtools --filter=@databuddy/sdk && changeset publish",
    "clean": "find . -type d \\( -name node_modules -o -name .next -o -name .turbo -o -name turbo \\) -prune -print -exec rm -rf {} +"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "next": "16.2.6",
      "typescript": "^5.9.3",
      "zod": "4.1.12",
      "autumn-js": "1.2.23",
      "elysia": "^1.4.28",
      "@types/bun": "1.3.14",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "ultracite": "^7.4.3",
      "drizzle-orm": "1.0.0-rc.1",
      "ua-parser-js": "^2.0.8",
      "evlog": "^2.11.1",
      "tokenlens": "^2.0.0-alpha.3",
      "@remotion/cli": "4.0.502",
      "@remotion/fonts": "4.0.502",
      "@remotion/media": "4.0.502",
      "remotion": "4.0.502"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^1.0.0-rc.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
